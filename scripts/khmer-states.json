{
 "about": "The screens the Khmer review's screenshots are taken from (npm run khmer-capture → /khmer-review capture): the LOCAL build of this static site, in Khmer, most typical first — the FIRST screen that shows an entry keeps it. Two screens are staged, never seen that way by a visitor: the explainer's four captions shown at once (a visitor sees one at a time, as it plays), and the 'link copied' message shown without pressing Share.",
 "base": "http://localhost:4331",
 "viewport": {
  "width": 390,
  "height": 844
 },
 "stamp": {
  "register": "M-0025",
  "rights": "reserved",
  "disclosure": "https://demo.heartbank.org/khmer/heartbank.org/"
 },
 "states": [
  {
   "id": "home",
   "url": "/km/",
   "ready": "main",
   "settle": 1500
  },
  {
   "id": "explainer-captions",
   "url": "/km/",
   "ready": "main",
   "eval": "document.body.insertAdjacentHTML('beforeend','<style>html body .exp-caps,html body .exp-ctl{display:block!important;position:static!important;min-height:0!important}html body .exp-caps span{position:static!important;opacity:1!important;display:block!important;margin:0 0 6px}</style>'); document.querySelector('.exp')?.scrollIntoView()",
   "settle": 1500
  },
  {
   "id": "skip-link",
   "url": "/km/",
   "ready": "main",
   "eval": "document.querySelector('a[href=\"#main\"]')?.focus()",
   "settle": 800
  },
  {
   "id": "link-copied",
   "url": "/km/",
   "ready": "main",
   "eval": "const t=document.getElementById('toast'); if (t) t.hidden=false",
   "settle": 800
  },
  {
   "id": "login",
   "url": "/login/",
   "ready": "main",
   "settle": 1200
  },
  {
   "id": "not-found",
   "url": "/404.html",
   "ready": "main",
   "settle": 1200
  }
 ]
}
